# Pinecone
PINECONE_API_KEY=
INDEX_NAME=preentrega4-hybrid-rag
PINECONE_NAMESPACE=technical-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings
# Recomendado para probar sin OpenAI: gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Gemini: gemini-embedding-2 + 768
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# Si prefieres OpenAI:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Modelo generativo para la demo RAG
GEMINI_MODEL=gemini-3.8-flash

# Retrieval
TOP_K=5
SEMANTIC_WEIGHT=0.65
LEXICAL_WEIGHT=0.35

# Chunking aproximado en tokens
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Datos
DATA_DIR=./data
MANIFEST_PATH=./.cache/ingestion_manifest.json
